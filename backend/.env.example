# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: gemini | claude | ollama | local
LLM_PROVIDER=gemini

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Starting model. Falls back automatically on quota/errors:
#   gemini-2.0-flash → gemini-2.5-flash-lite → gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Anthropic Claude (optional) ───────────────────────────────────────────────
# Only required when LLM_PROVIDER=claude
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Only required when LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3.5

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
