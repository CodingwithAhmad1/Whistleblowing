# LLM Provider: gemini | ollama | local
# - gemini: Uses Google Gemini 1.5 Flash (requires GEMINI_API_KEY)
# - ollama: Uses local Ollama (requires Ollama running)
# - local: Uses llama-cpp Phi model (downloads on first run)
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_api_key_here

# Optional: Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# When LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3.5

# CORS origins (comma-separated or JSON array)
# CORS_ORIGINS=["http://localhost:5173"]
