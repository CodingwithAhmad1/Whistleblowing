{
  "name": "reportiq",
  "private": true,
  "scripts": {
    "start": "concurrently -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:stack": "npm run start",
    "dev:stack": "npm run start",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "npm run start",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:frontend && cd backend && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
